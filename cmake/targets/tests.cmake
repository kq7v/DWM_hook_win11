set( DWM_REFERENCE_DLL "" CACHE FILEPATH "Optional offline dwmcore.dll for native ABI checks" )
function( add_regression_test name )
    add_executable( ${name} ${ARGN} )
    target_include_directories( ${name} PRIVATE "${PROJECT_SOURCE_DIR}/src" )
    target_compile_definitions( ${name} PRIVATE WIN32_LEAN_AND_MEAN NOMINMAX UNICODE _UNICODE _WIN32_WINNT=0x0A00 )
    target_compile_options( ${name} PRIVATE /W4 /WX /permissive- /utf-8 )
    target_sources( ${name} PRIVATE src/common/diagnostics/log.cpp )
    set_target_properties( ${name} PROPERTIES FOLDER tests )
    add_test( NAME ${name} COMMAND ${name} )
endfunction( )
add_regression_test( native_abi tests/native_abi.cpp src/sdk/dwm/dwm.cpp src/sdk/dwm/frame.cpp
    src/sdk/dwm/detail/layout.cpp src/common/memory/pattern.cpp )
target_link_libraries( native_abi PRIVATE libhat::libhat d3d11 dxgi user32 )
set_tests_properties( native_abi PROPERTIES SKIP_RETURN_CODE 77 )
if( DWM_REFERENCE_DLL )
    set_tests_properties( native_abi PROPERTIES ENVIRONMENT "DWM_REFERENCE_DLL=${DWM_REFERENCE_DLL}" )
endif( )
add_regression_test( frame_pipeline tests/frame_pipeline.cpp src/sdk/hooks/compose.cpp
    src/sdk/hooks/end_frame.cpp src/sdk/hooks/present.cpp src/backends/dwm/context.cpp
    src/backends/dwm/frame.cpp src/backends/dwm/renderer.cpp )
target_link_libraries( frame_pipeline PRIVATE imgui dxgi user32 )
